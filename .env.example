# Copy this file to .env and fill in the values. Never commit .env or paste values anywhere.
# Upload the same values to GitHub (for the hourly run) with:  gh secret set -f .env

# Alpaca PAPER keys (start with "PK"). The code refuses anything else.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Cloudflare account ID (dashboard -> Workers & Pages -> right sidebar)
CLOUDFLARE_ACCOUNT_ID=
# API token with Account -> D1 -> Edit (My Profile -> API Tokens -> Create Custom Token)
CLOUDFLARE_API_TOKEN=
# R2 API token with Object Read & Write on bucket trader-data (R2 -> Manage R2 API Tokens)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Telegram bot token from @BotFather, and your chat ID (run scripts/telegram_chat_id.py to find it)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GitHub fine-grained token for the Cloudflare scheduler: repository Ottschek/trader only,
# permission "Actions: Read and write". Create at github.com/settings/personal-access-tokens/new
GITHUB_DISPATCH_TOKEN=
